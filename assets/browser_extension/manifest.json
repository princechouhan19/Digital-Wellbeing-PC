{
  "manifest_version": 3,
  "name": "Digital Wellbeing — Companion",
  "version": "2.0.0",
  "description": "Companion extension for Digital Wellbeing desktop app. Enforces granular Focus web rules, shields distracting feeds, and syncs active tabs with zero cloud telemetry.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Digital Wellbeing",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.reddit.com/*"
      ],
      "js": [
        "content/feed_shield.js"
      ],
      "run_at": "document_start"
    }
  ]
}
